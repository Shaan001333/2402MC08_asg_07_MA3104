+int
+set_priority(int pid, int priority)
+{
+  struct proc *p;
+  int old = -1;
+  if(priority < 1 || priority > 20)
+    return -1;
+  acquire(&ptable.lock);
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++)
+    if(p->pid == pid){
+      old = p->priority;
+      p->priority = priority;
+      break;
+    }
+  release(&ptable.lock);
+  return old;
+}
+
+int
+get_priority(int pid)
+{
+  struct proc *p;
+  int prio = -1;
+  acquire(&ptable.lock);
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++)
+    if(p->pid == pid){
+      prio = p->priority;
+      break;
+    }
+  release(&ptable.lock);
+  return prio;
+}
+
+// aging: called every timer tick; RUNNABLE procs waiting > 30 ticks
+// get priority boosted by 1 (number decremented) and counter reset
+void
+age_procs(void)
+{
+  struct proc *p;
+  acquire(&ptable.lock);
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+    if(p->state == RUNNABLE){
+      p->waitticks++;
+      if(p->waitticks > 30){
+        if(p->priority > 1)
+          p->priority--;
+        p->waitticks = 0;
+      }
+    }
+  }
+  release(&ptable.lock);
+}
