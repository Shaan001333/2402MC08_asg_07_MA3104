+// Threads: clone() creates a proc sharing the caller's address space
+int
+clone(void (*fcn)(void *), void *arg, void *stack)
+{
+  int i, pid;
+  struct proc *np;
+  struct proc *cur = myproc();
+  uint *sp;
+
+  if((np = allocproc()) == 0)
+    return -1;
+
+  np->pgdir = cur->pgdir;      // SHARE address space (no copyuvm!)
+  np->sz = cur->sz;
+  np->isthread = 1;
+  np->parent = cur;
+  np->cwd = idup(cur->cwd);
+  safestrcpy(np->name, "thread", sizeof(np->name));
+  for(i = 0; i < NOFILE; i++)
+    if(cur->ofile[i])
+      np->ofile[i] = filedup(cur->ofile[i]);
+
+  *np->tf = *cur->tf;
+  sp = (uint*)((char*)stack + PGSIZE);   // top of user stack page
+  sp -= 1; *sp = (uint)arg;              // argument
+  sp -= 1; *sp = 0xffffffff;             // fake return PC
+  np->tf->esp = (uint)sp;
+  np->tf->eip = (uint)fcn;
+  np->tf->eax = 0;
+
+  acquire(&ptable.lock);
+  np->state = RUNNABLE;
+  pid = np->pid;
+  release(&ptable.lock);
+  return pid;
+}
+
+// join() waits for a thread child (made by clone) to exit
+int
+join(void)
+{
+  struct proc *p;
+  int havekids, pid;
+  struct proc *cur = myproc();
+
+  acquire(&ptable.lock);
+  for(;;){
+    havekids = 0;
+    for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+      if(p->parent != cur || !p->isthread)
+        continue;
+      havekids = 1;
+      if(p->state == ZOMBIE){
+        pid = p->pid;
+        kfree(p->kstack);        // its own kernel stack
+        p->kstack = 0;
+        p->state = UNUSED;       // NO freevm: pgdir is shared!
+        p->pid = 0;
+        p->parent = 0;
+        p->isthread = 0;
+        p->name[0] = 0;
+        p->killed = 0;
+        release(&ptable.lock);
+        return pid;
+      }
+    }
+    if(!havekids || cur->killed){
+      release(&ptable.lock);
+      return -1;
+    }
+    sleep(cur, &ptable.lock);
+  }
+}
+
+// Asg7 Q2: counting semaphores (fixed kernel array, sleep/wakeup based)
+#define NSEM 10
+struct semaphore {
+  int value;
+  struct spinlock lk;
+  int inuse;
+};
+struct semaphore sems[NSEM];
+static int sems_initialized = 0;
+
+static void
+init_sems(void)
+{
+  int i;
+  if(!sems_initialized){
+    for(i = 0; i < NSEM; i++){
+      initlock(&sems[i].lk, "sem");
+      sems[i].inuse = 0;
+    }
+    sems_initialized = 1;
+  }
+}
+
+int
+sem_init(int sem_id, int value)
+{
+  if(sem_id < 0 || sem_id >= NSEM)
+    return -1;
+  init_sems();
+  acquire(&sems[sem_id].lk);
+  sems[sem_id].value = value;
+  sems[sem_id].inuse = 1;
+  release(&sems[sem_id].lk);
+  return 0;
+}
+
+int
+sem_wait(int sem_id)
+{
+  if(sem_id < 0 || sem_id >= NSEM)
+    return -1;
+  acquire(&sems[sem_id].lk);
+  while(sems[sem_id].value <= 0)          // block while none available
+    sleep(&sems[sem_id], &sems[sem_id].lk);
+  sems[sem_id].value--;                   // decrement
+  release(&sems[sem_id].lk);
+  return 0;
+}
+
+int
+sem_signal(int sem_id)
+{
+  if(sem_id < 0 || sem_id >= NSEM)
+    return -1;
+  acquire(&sems[sem_id].lk);
+  sems[sem_id].value++;                   // increment
+  wakeup(&sems[sem_id]);                  // wake waiters (recheck makes it safe)
+  release(&sems[sem_id].lk);
+  return 0;
+}
